# SMTP Email Configuration for Contact Form (/api/contact)
# Copy this file to .env.local (for local dev) or .env (on production server) and fill in real values.

# Option A: Gmail / Google Workspace
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@mprog.eu
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # 16-digit Google App Password

# Option B: Custom Hosting SMTP (e.g., IONOS, Strato, Hetzner, Hostinger)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@mprog.eu
SMTP_PASS=your-app-password-or-smtp-password

# Optional overrides (defaults to SMTP_USER and info@mprog.eu)
SMTP_FROM=info@mprog.eu
SMTP_TO=info@mprog.eu
